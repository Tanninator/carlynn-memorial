{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "carlynn-memorial",
	"compatibility_date": "2026-05-12",
	"main": "src/worker.js",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": ".",
		"binding": "ASSETS"
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{
			"pattern": "carlynnwu.com",
			"zone_name": "carlynnwu.com",
			"custom_domain": true
		}
	],
	"vars": {
		"NOTIFY_TO": "godwin.law@acts2.network",
		"NOTIFY_FROM": "onboarding@resend.dev"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "carlynn-rsvps",
			"database_id": "REPLACE_AFTER_WRANGLER_D1_CREATE",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "carlynn-lanterns"
		},
		{
			"bucket_name": "carlynn-lanterns",
			"binding": "carlynn_lanterns",
			"remote": true
		}
	]
}
